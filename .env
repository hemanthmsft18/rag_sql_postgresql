AZURE_OPENAI_ENDPOINT={AZURE_OPENAI_ENDPOINT}
AZURE_OPENAI_API_KEY={AZURE_OPENAI_API_KEY}
AZURE_OPENAI_EMBEDDING_MODEL_DEPLOYMENT_NAME={AZURE_OPENAI_EMBEDDING_MODEL_DEPLOYMENT_NAME}

# Use only one of the below. The one you are not using should be commented out.

# For Entra ID Authentication
#ENTRAID_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:demosqlservercsn.database.windows.net,1433;Database=demodb_CSN;Uid={your_user_name};Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;Authentication=ActiveDirectoryIntegrated"

# For SQL Authentication
SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:sqlserver.database.windows.net;Database=sqldb;Uid={userid};Pwd={pwd};Encrypt=yes;LongAsMax=yes;TrustServerCertificate=no;Connection Timeout=30;"